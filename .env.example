# Application
PORT=8080
GIN_MODE=debug

# Database
DATABASE_URL=postgres://postgres:password@localhost:5436/trailnest?sslmode=disable

# Authentication
JWT_SECRET=replace-with-a-secret-of-at-least-32-characters

# Email - Resend
RESEND_API_KEY=
EMAIL_FROM=

# Application URL
APP_BASE_URL=http://localhost:8081

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Image Storage
# Supported drivers: local, s3
IMAGE_STORAGE_DRIVER=local

# Local Image Storage
IMAGE_STORAGE_DIRECTORY=uploads/activities
IMAGE_STORAGE_PUBLIC_URL=/uploads/activities

# AWS S3 - required when IMAGE_STORAGE_DRIVER=s3
S3_BUCKET=
AWS_REGION=ap-south-1

# Trusted Reverse Proxies (comma-separated IPs or CIDRs)
TRUSTED_PROXIES=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8090
